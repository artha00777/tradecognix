# ======================================================================
# TradeCognix environment. Copy to .env and fill in. NEVER commit .env.
# ======================================================================

# --- App ---------------------------------------------------------------
# production = refuses to start with a default/short JWT_SECRET, wildcard CORS or no FERNET_KEY
ENVIRONMENT=development
# SQLite by default; Postgres (e.g. Supabase free tier) via postgresql://user:pass@host:5432/db
DATABASE_URL=sqlite:///./tradecognix.db
# Comma-separated origins allowed to call the API (your Vercel/Netlify site, admin console)
CORS_ORIGINS=http://localhost:8080,https://tradecognix.vercel.app
# true only behind a reverse proxy you control (Render, Nginx): rate limits then key on X-Forwarded-For
TRUST_PROXY_HEADERS=false

# --- Security ----------------------------------------------------------
# python -c "import secrets;print(secrets.token_urlsafe(48))"   (>= 32 chars, required in production)
JWT_SECRET=change-me
JWT_EXPIRE_MINUTES=720
# python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
FERNET_KEY=
# Users registering with these emails become admins
ADMIN_EMAILS=contact@devcognix.com
PASSWORD_MIN_LENGTH=8

# --- Rate limits (in-memory, per process; "<requests>/<seconds>") ------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN=10/300
RATE_LIMIT_LOGIN_IP=30/300
RATE_LIMIT_REGISTER=10/3600
RATE_LIMIT_PUBLIC=30/600

# --- Billing: Razorpay (checkout answers 503 until both keys are set) ---
# Dashboard -> Account & Settings -> API Keys. Use rzp_test_... keys until go-live.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard -> Webhooks (events: order.paid, payment.captured) -> URL https://<api>/api/billing/webhook
RAZORPAY_WEBHOOK_SECRET=

# --- Trading safety ----------------------------------------------------
# Master switch. Live orders also need per-strategy confirmation + typed "LIVE" in the UI.
LIVE_TRADING_ENABLED=false
# Public static IP of this server, registered/whitelisted with your broker (SEBI retail-algo rules)
STATIC_IP=
SCHEDULER_ENABLED=true
PAPER_STARTING_CAPITAL=500000
DEFAULT_SLIPPAGE_PCT=0.5

# --- Angel One SmartAPI (optional server default; users can store their own, encrypted) ---
ANGEL_API_KEY=
ANGEL_CLIENT_CODE=
ANGEL_PIN=
ANGEL_TOTP_SECRET=

# --- LLM strategy parsing (optional; rule-based parser is always the fallback) ---
# Google Gemini free tier: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Or any OpenAI-compatible endpoint (Ollama http://localhost:11434/v1, Groq, OpenRouter...)
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=llama3.1

# --- docker-compose Postgres ---
POSTGRES_USER=tradecognix
POSTGRES_PASSWORD=change-me
POSTGRES_DB=tradecognix
